# PostgreSQL (Neon or another external PostgreSQL instance)
DB_URL=jdbc:postgresql://YOUR_NEON_HOST/YOUR_DATABASE?sslmode=require
DB_USERNAME=YOUR_DATABASE_USER
DB_PASSWORD=YOUR_DATABASE_PASSWORD

# Local-only values. Never reuse these defaults in production.
VOZLY_JWT_SECRET=local-only-change-this-secret-to-at-least-32-bytes
VOZLY_JWT_ISSUER=http://localhost:4200
VOZLY_JWT_AUDIENCE=vozly-api

# Microsoft Entra ID (optional for local email/password development)
MICROSOFT_TENANT_ID=organizations
MICROSOFT_CLIENT_ID=local-not-configured
MICROSOFT_CLIENT_SECRET=local-not-configured
