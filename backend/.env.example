# PostgreSQL connection (local profile)
DB_URL=jdbc:postgresql://localhost:5432/vozly
DB_USERNAME=vozly
DB_PASSWORD=change-me
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2

# HTTP server
PORT=8080

# JWT: use a cryptographically random secret with at least 32 bytes.
VOZLY_JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
VOZLY_JWT_ISSUER=https://api.vozly.local
VOZLY_JWT_AUDIENCE=vozly-api

# Frontend and secure refresh cookie
FRONTEND_URL=http://localhost:4200
COOKIE_SECURE=false

# Microsoft Entra ID - register this redirect URI in the Entra app:
# http://localhost:8080/login/oauth2/code/microsoft
MICROSOFT_TENANT_ID=organizations
MICROSOFT_CLIENT_ID=replace-with-application-client-id
MICROSOFT_CLIENT_SECRET=replace-with-client-secret
